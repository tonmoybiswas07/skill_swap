# Use an Atlas cluster or a MongoDB replica set to enable transactions.
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DATABASE=skillswap

# Generate a local secret with openssl rand -base64 32.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional. Set only when seeding the separate skillswap_demo database.
DEMO_PASSWORD=

# Optional. Use a local or dedicated replica set for transaction tests.
TEST_MONGODB_URI=

# Optional. Comma-separated Better Auth user IDs of independent dispute moderators.
DISPUTE_MODERATOR_IDS=

# Optional. Exact institutional email domains mapped to public badge labels.
# CAMPUS_EMAIL_DOMAINS=university.edu=Example University
CAMPUS_EMAIL_DOMAINS=
RESEND_API_KEY=
CAMPUS_EMAIL_FROM=

# Optional. Verified Resend sender for scheduled session email reminders.
SESSION_REMINDER_FROM=
